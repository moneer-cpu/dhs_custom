<odoo>
    <template id="report_account_invoice_document_inherit" inherit_id="l10n_gcc_invoice.arabic_english_invoice">

        <!-- Remove unwanted inherited blocks -->
        <xpath expr="//t[@t-set='o']" position="replace"/>
        <xpath expr="//t[@t-set='forced_vat']" position="replace"/>
        <xpath expr="//t[@t-set='address']" position="replace"/>
        <xpath expr="//div[@id='informations']" position="replace">
            <div/>
        </xpath>
        <xpath expr="(//div[hasclass('col-4')])[1]" position="replace"/>
        <xpath expr="(//div[hasclass('col-4')])[2]" position="attributes">
            <attribute name="style">text-align:left</attribute>
        </xpath>
        <xpath expr="//div[hasclass('col-4') and hasclass('text-center')]" position="replace"/>
        <xpath expr="//span[@t-if=&quot;o.move_type == 'out_invoice' and o.state == 'posted'&quot;]" position="replace">
            <span class="text-start o_report_text" t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                <strong>
                    TAX INVOICE
                    /
                    الفاتورة ضريبية
                </strong>
            </span>
        </xpath>


        <!-- Custom header before table -->
        <xpath expr="//table[contains(@class, 'table')]" position="before">

            <table class="table o_main_table o_table_striped table-borderless">
                <thead>
                    <tr>
                        <th>Customer Details / بيانات العميل</th>
                        <th>Invoice Details / تفاصيل الفاتورة</th>
                    </tr>
                </thead>
                <!-- Row 1 -->
                <tr>
                    <td>
                        <strong>Provider Name / اسم المزود</strong>
                        <br/>
                        <span t-field="o.partner_id"/>
                    </td>
                    <td>
                        <strong>Invoice Date / تاريخ الفاتورة</strong>
                        <br/>
                        <span t-field="o.invoice_date"/>
                    </td>
                </tr>

                <!-- Row 2 -->
                <tr>
                    <td>
                        <strong>Location / العنوان</strong>
                        <br/>
                        <div>
                            <t t-esc="o.partner_id.street"/>
                            <t t-if="o.partner_id.street2">,
                                <t t-esc="o.partner_id.street2"/>
                            </t>
                            <t t-if="o.partner_id.city">,
                                <t t-esc="o.partner_id.city"/>
                            </t>
                            <t t-if="o.partner_id.country_id">,
                                <t t-esc="o.partner_id.country_id.name"/>
                            </t>
                        </div>
                    </td>
                    <td>
                        <strong>Invoice Number / رقم الفاتورة</strong>
                        <br/>
                        <span t-field="o.name"/>
                    </td>
                </tr>

                <!-- Row 3 -->
                <tr>
                    <td>
                        <strong>Contact Person / الشخص المسؤول</strong>
                        <br/>
                        <span t-field="o.invoice_user_id"/>
                    </td>
                    <td>
                        <strong>Client Reference / مرجع العميل</strong>
                        <br/>
                        <span t-field="o.partner_id.ref"/>
                    </td>
                </tr>

                <!-- Row 4 -->
                <tr>
                    <td>
                        <strong>Contact Number / رقم التواصل</strong>
                        <br/>
                        <span t-field="o.partner_id.phone"/>
                    </td>
                    <td>
                        <strong>Due Date / تاريخ الاستحقاق</strong>
                        <br/>
                        <span t-field="o.invoice_date_due"/>
                    </td>
                </tr>

                <!-- Row 5 -->
                <tr>
                    <td>
                        <strong>Email / البريد الإلكتروني</strong>
                        <br/>
                        <span t-field="o.partner_id.email"/>
                    </td>
                    <td>
                        <strong>Contract Reference / مرجع الاتفاقية</strong>
                        <br/>
                        <span t-field="o.partner_id.contract_no"/>
                    </td>
                </tr>

                <!-- Row 6 -->
                <tr>
                    <td>
                        <strong>VAT Registration / الرقم الضريبي</strong>
                        <br/>
                        <span t-field="o.partner_id.vat"/>
                    </td>
                    <td>
                        <strong>NPHIES ID / رقم نفيس الموحد</strong>
                        <br/>
                        <span t-field="o.partner_id.nphies"/>
                    </td>
                </tr>

                <!-- Row 7 -->
                <tr>
                    <td>
                        <strong>DHS CODE / كود الشركة</strong>
                        <br/>
                        <!--                        <span t-field="o.company_id.dhs_code"/>-->
                    </td>
                    <td>
                        <strong>CHI CODE / كود مجلس الضمان الصحي</strong>
                        <br/>
                        <span t-field="o.partner_id.cchi"/>
                    </td>
                </tr>
            </table>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']/thead/tr" position="before">
            <tr>
                <th colspan="7" class="text-start fw-bold">Invoice Items/بنود الفاتورة</th>
            </tr>
        </xpath>
        <xpath expr="//p[@name='payment_term' and @t-if='o.invoice_payment_term_id']" position="after">
            <table class="table o_main_table o_table_striped table-borderless" name="bank_details_title">
                <thead>
                    <tr>
                        <th class="text-start">Banking Details</th>
                        <th class="text-end">تفاصيل البنك</th>
                    </tr>
                </thead>
            </table>
            <div class="row" name="bank_details_content">
                <!-- English side -->
                <div class="col-6">
                    <t t-foreach="o.company_id.partner_id.bank_ids" t-as="bank">
                        Beneficiary’s Name:
                        <t t-esc="o.company_id.partner_id.name"/>
                        <br/>
                        Bank:
                        <t t-esc="bank.bank_id.name"/>
                        <br/>
                        Account NO:
                        <t t-esc="bank.acc_number"/>
                        <br/>
                        <!--                        IBAN NO:-->
                        <!--                        <t t-esc="bank.iban"/>-->
                        <!--                        <br/>-->
                    </t>
                    <strong>Please include the invoice number in the Transfer reference.</strong>
                    <br/>
                    Email:
                    <t t-esc="o.company_id.partner_id.email"/>
                </div>

                <!-- Arabic side -->
                <div class="col-6 text-end">
                    <t t-foreach="o.company_id.partner_id.bank_ids" t-as="bank">
                        <t t-esc="o.company_id.partner_id.name"/>
                        :اسم المستفيد
                        <br/>
                        <t t-esc="bank.bank_id.name"/>
                        :البنك
                        <br/>
                        رقم الحساب:
                        <t t-esc="bank.acc_number"/>
                        <br/>
                        <!--                        رقم الآيبان:-->
                        <!--                        <t t-esc="bank.iban"/>-->
                        <!--                        <br/>-->
                    </t>
                    <strong>يرجى تضمين رقم الفاتورة في مرجع التحويل.</strong>
                    <br/>
                    <t t-esc="o.company_id.partner_id.email"/>
                    :البريد الإلكتروني
                </div>
            </div>

        </xpath>
        <xpath expr="//p[@name='comment' and @t-if='o.narration']" position="before">
            <table class="table o_main_table o_table_striped table-borderless" name="terms_title">
                <thead>
                    <tr>
                        <th class="text-start">Terms &amp; Conditions</th>
                        <th class="text-end">الشروط والأحكام</th>
                    </tr>
                </thead>
            </table>
        </xpath>
    </template>

</odoo>
